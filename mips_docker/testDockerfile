FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-user-static \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY romfs.tar.gz .
RUN mkdir -p /app/romfs && tar xf romfs.tar.gz -C /app/romfs && rm romfs.tar.gz

# Копируем системные библиотеки uClibc для QEMU в /app/romfs/lib/
COPY sys_lib/ /app/romfs/lib/

# Cоздаем кастомную директорию Klish и копируем её библиотеки
RUN mkdir -p /app/romfs/opt/klish/lib
COPY opt_klish_lib/ /app/romfs/opt/klish/lib/

# Копируем исполняемый бинарник
COPY clish /app/romfs/usr/bin/clish
RUN chmod +x /app/romfs/usr/bin/clish

# Копируем XML-конфигурации
RUN mkdir -p /app/romfs/etc/clish
COPY clish_xml/ /app/romfs/etc/clish/

# Заглушка reboot
RUN mkdir -p /app/romfs/sbin /app/romfs/usr/sbin /app/romfs/bin /app/romfs/root && \
    echo '#!/bin/sh' > /app/romfs/sbin/reboot && \
    echo 'echo "[ЭМУЛЯТОР] Перезагрузка. Выход из Klish..."' >> /app/romfs/sbin/reboot && \
    echo 'kill -TERM $PPID' >> /app/romfs/sbin/reboot && \
    chmod +x /app/romfs/sbin/reboot && \
    ln -sf /app/romfs/sbin/reboot /app/romfs/usr/sbin/reboot && \
    ln -sf /app/romfs/sbin/reboot /app/romfs/bin/reboot

USER root

CMD ["qemu-mips-static", "-L", "/app/romfs", "-E", "CLISH_PATH=/etc/clish", "/app/romfs/usr/bin/clish"]