<?xml version="1.0" encoding="UTF-8"?>
<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
                                  http://clish.sourceforge.net/XMLSchema/clish.xsd">

    <!-- Описание основного режима устройства (Cisco-like prompt) -->
    <VIEW name="main_view" prompt="mips-device> ">

        <!-- Требуемая пробная команда: reboot -->
        <COMMAND name="reboot" 
                 help="Перезагрузка устройства2">
            <ACTION>
                /sbin/reboot
            </ACTION>
        </COMMAND>

        <!-- Пример составной команды для проверки каркаса -->
        <COMMAND name="show version" 
                 help="Показать информацию о версии системы">
            <ACTION>
                echo "OS: Embedded Linux (MIPS architecture)"
                uname -r
            </ACTION>
        </COMMAND>

        <!-- Команда корректного выхода из SSH-сессии -->
        <COMMAND name="exit" 
                 help="Выход из командной оболочки">
            <ACTION builtin="clish_close" />
        </COMMAND>

    </VIEW>

</CLISH_MODULE>