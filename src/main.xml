<?xml version="1.0" encoding="UTF-8"?>
<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
                                  http://clish.sourceforge.net/XMLSchema/clish.xsd">

    <!-- Загружаем базовый плагин для обработки тегов ACTION -->
    <PLUGIN name="clish"/>

    <VIEW name="main_view" prompt="mips-device> ">

        <COMMAND name="reboot" help="Reboot the MIPS device">
            <ACTION>
                echo "System is going down for reboot..."
                /sbin/reboot
            </ACTION>
        </COMMAND>

        <COMMAND name="show version" 
                 help="Показать информацию о версии системы">
            <ACTION>
                echo "OS: Embedded Linux (MIPS architecture)"
                uname -r
            </ACTION>
        </COMMAND>

        <COMMAND name="exit" 
                 help="Выход из командной оболочки">
            <ACTION builtin="clish_close" />
        </COMMAND>

    </VIEW>

</CLISH_MODULE>